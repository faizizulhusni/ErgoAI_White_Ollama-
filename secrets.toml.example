# Streamlit Community Cloud Secrets Template
# -------------------------------------------------------------
# If you want to use a live Cloud LLM on Streamlit Cloud, add ANY of these options
# in your Streamlit Cloud App Settings -> Secrets:

# Option 1: Groq (Recommended - Free, high-speed Llama 3 models)
# OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
# OPENAI_API_KEY = "gsk_your_groq_api_key_here"
# OPENAI_MODEL = "llama-3.3-70b-versatile"

# Option 2: OpenRouter (Supports free & paid Llama models)
# OPENAI_BASE_URL = "https://openrouter.ai/api/v1"
# OPENAI_API_KEY = "sk-or-your_openrouter_key"
# OPENAI_MODEL = "meta-llama/llama-3.2-3b-instruct:free"

# Option 3: Remote Ollama (e.g. ngrok tunnel or self-hosted VPS)
# OLLAMA_API_URL = "https://your-ngrok-tunnel.ngrok-free.app/v1"
# OLLAMA_MODEL = "llama3.2"

# NOTE: If no secrets are set, the dashboard automatically runs in
# Autonomous AI Simulation mode with complete ergonomic reasoning.
